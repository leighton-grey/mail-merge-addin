<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Mail Merge Outlook Add-in Manifest (Exchange Server / Enterprise) — on-premises Exchange and Outlook client -->
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
  xsi:type="MailApp">

  <!-- Unique GUID for this add-in — same ID as manifest.xml; distinguishes in internal catalogs by hosted domain -->
  <Id>6917ba68-9d86-45d7-8ca5-354503f5983a</Id>
  <!-- Version number — typically incremented separately from manifest.xml for independent releases -->
  <Version>2.6.0.0</Version>
  <!-- Publisher name for internal/enterprise distributions -->
  <ProviderName>Promethean IT</ProviderName>
  <!-- Default language/locale for all default/invariant text values -->
  <DefaultLocale>en-US</DefaultLocale>
  <!-- Add-in name shown to users in Outlook and system administration interfaces -->
  <DisplayName DefaultValue="Mail Merge"/>
  <!-- Short description for catalog/store listings -->
  <Description DefaultValue="CSV mail merge with scheduling, opt-out list, and rate limiting."/>

  <!-- IconUrl and HighResolutionIconUrl: must be HTTPS; some Exchange environments restrict cross-origin icon loads -->
  <IconUrl DefaultValue="https://leighton-grey.github.io/mail-merge-addin/assets/icon-80.png"/>
  <HighResolutionIconUrl DefaultValue="https://leighton-grey.github.io/mail-merge-addin/assets/icon-80.png"/>

  <!-- SupportUrl: link shown in add-in details; customers click here for help or bug reports -->
  <SupportUrl DefaultValue="https://leighton-grey.github.io/mail-merge-addin"/>

  <!-- AppDomains: Outlook restricts dialog navigation to these domains; note no protocol/path here for broader matching -->
  <AppDomains>
    <AppDomain>leighton-grey.github.io</AppDomain>
  </AppDomains>

  <!-- Hosts: specifies Mail add-in type -->
  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>

  <!-- Requirements: minimum API set versions for legacy/fallback activation (FormSettings rule below) -->
  <Requirements>
    <Sets>
      <!-- Mailbox 1.1 is baseline for Exchange on-premises and legacy Outlook desktop clients -->
      <Set Name="Mailbox" MinVersion="1.1"/>
    </Sets>
  </Requirements>

  <!-- FormSettings + Rule: v1.1 legacy activation for older clients that ignore VersionOverrides -->
  <FormSettings>
    <Form xsi:type="ItemEdit">
      <DesktopSettings>
        <!-- SourceLocation: URL to the taskpane; HTTPS required, cannot be localhost or internal IPs in many configurations -->
        <SourceLocation DefaultValue="https://leighton-grey.github.io/mail-merge-addin/taskpane.html"/>
      </DesktopSettings>
    </Form>
  </FormSettings>

  <!-- Permissions: ReadWriteMailbox allows modifying mail item data and sending; required for merge operations -->
  <Permissions>ReadWriteMailbox</Permissions>

  <!-- Rule: when add-in shows in ribbon; matches compose/reply/forward scenarios only -->
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Edit"/>
  </Rule>

  <!-- VersionOverrides: modern ribbon UI and command definitions used by Windows Outlook and web clients -->
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">

    <!-- Requirements in VersionOverrides override top-level Requirements for modern clients -->
    <Requirements>
      <!-- DefaultMinVersion 1.3 supports FunctionFile (commands.html) and advanced ribbon customization -->
      <bt:Sets DefaultMinVersion="1.3">
        <bt:Set Name="Mailbox"/>
      </bt:Sets>
    </Requirements>

    <!-- Hosts: ribbon UI and command surface definitions -->
    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>

          <!-- FunctionFile: URL to commands.html (hidden iframe) that handles ribbon button commands; must be served over HTTPS -->
          <FunctionFile resid="Commands.Url"/>

          <!-- ExtensionPoint: MessageComposeCommandSurface = buttons appear in the compose ribbon -->
          <ExtensionPoint xsi:type="MessageComposeCommandSurface">
            <!-- OfficeTab id="TabDefault": adds button to default Home tab -->
            <OfficeTab id="TabDefault">
              <!-- Group: button group with label and visual grouping in the ribbon -->
              <Group id="msgComposeGroup">
                <Label resid="GroupLabel"/>
                <!-- Control: the "Run Merge" button; ShowTaskpane loads taskpane.html in a side panel on click -->
                <Control xsi:type="Button" id="btnOpenMerge">
                  <Label resid="TaskpaneButton.Label"/>
                  <Supertip>
                    <Title resid="TaskpaneButton.SupertipTitle"/>
                    <Description resid="Btn.TipDesc"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>

        </DesktopFormFactor>
      </Host>
    </Hosts>

    <!-- Resources: all images, URLs, and localizable strings referenced via resid in manifest above -->
    <Resources>
      <!-- bt:Images: icon PNG files in multiple sizes for ribbon, store, and system UI -->
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://leighton-grey.github.io/mail-merge-addin/assets/icon-16.png"/>
        <bt:Image id="Icon.32x32" DefaultValue="https://leighton-grey.github.io/mail-merge-addin/assets/icon-32.png"/>
        <bt:Image id="Icon.80x80" DefaultValue="https://leighton-grey.github.io/mail-merge-addin/assets/icon-80.png"/>
      </bt:Images>
      <!-- bt:Urls: Commands.Url points to commands.html (hidden iframe); Taskpane.Url is the visible side panel -->
      <bt:Urls>
        <bt:Url id="Commands.Url" DefaultValue="https://leighton-grey.github.io/mail-merge-addin/taskpane.html"/>
        <bt:Url id="Taskpane.Url" DefaultValue="https://leighton-grey.github.io/mail-merge-addin/taskpane.html"/>
      </bt:Urls>
      <!-- bt:ShortStrings: ribbon labels; brief enough to fit in compact ribbon layouts -->
      <bt:ShortStrings>
        <bt:String id="GroupLabel" DefaultValue="Mail Merge"/>
        <bt:String id="TaskpaneButton.Label" DefaultValue="Run Merge"/>
        <bt:String id="TaskpaneButton.SupertipTitle" DefaultValue="Run Mail Merge"/>
      </bt:ShortStrings>
      <!-- bt:LongStrings: tooltip and help text; shown on button hover and in Office Store descriptions -->
      <bt:LongStrings>
        <bt:String id="Btn.TipDesc" DefaultValue="Open the Mail Merge task pane to send personalised emails to multiple recipients."/>
      </bt:LongStrings>
    </Resources>

  </VersionOverrides>

</OfficeApp>
