<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xsi:type="MailApp">

  <Id>a3a648da-9dc0-48ce-948a-ba2434afcadd</Id>
  <Version>2.4.0</Version>
  <ProviderName>Promethean IT</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Mail Merge"/>
  <Description DefaultValue="Personalized bulk email directly in New Outlook. Replaces classic Word-to-Outlook mail merge. Processes all data locally — zero data touches our servers."/>

  <IconUrl DefaultValue="https://leighton-grey.github.io/mail-merge-addin/assets/icon-80.png"/>
  <HighResolutionIconUrl DefaultValue="https://leighton-grey.github.io/mail-merge-addin/assets/icon-80.png"/>
  <SupportUrl DefaultValue="https://leighton-grey.github.io/mail-merge-addin"/>

  <AppDomains>
    <AppDomain>https://leighton-grey.github.io</AppDomain>
    <AppDomain>https://login.microsoftonline.com</AppDomain>
    <AppDomain>https://graph.microsoft.com</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>

  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.10"/>
    </Sets>
  </Requirements>

  <FormSettings>
    <Form xsi:type="ItemEdit">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://leighton-grey.github.io/mail-merge-addin/taskpane.html"/>
        <RequestedHeight>550</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>

  <Permissions>ReadWriteMailbox</Permissions>

  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Edit"/>
  </Rule>

  <DisableEntityHighlighting>false</DisableEntityHighlighting>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">

    <Requirements>
      <bt:Sets DefaultMinVersion="1.10">
        <bt:Set Name="Mailbox"/>
      </bt:Sets>
    </Requirements>

    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>
          <FunctionFile resid="Taskpane.Url"/>
          <ExtensionPoint xsi:type="MessageComposeCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="msgComposeGroup">
                <Label resid="GroupLabel"/>
                <Icon>
                  <bt:Image size="16" resid="Icon.16x16"/>
                  <bt:Image size="32" resid="Icon.32x32"/>
                  <bt:Image size="80" resid="Icon.80x80"/>
                </Icon>
                <Control xsi:type="Button" id="MessageComposeActionId">
                  <Label resid="TaskpaneButton.Label"/>
                  <Supertip>
                    <Title resid="TaskpaneButton.Label"/>
                    <Description resid="TaskpaneButton.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>MailMergePane</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>

    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://leighton-grey.github.io/mail-merge-addin/assets/icon-16.png"/>
        <bt:Image id="Icon.32x32" DefaultValue="https://leighton-grey.github.io/mail-merge-addin/assets/icon-32.png"/>
        <bt:Image id="Icon.80x80" DefaultValue="https://leighton-grey.github.io/mail-merge-addin/assets/icon-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Taskpane.Url" DefaultValue="https://leighton-grey.github.io/mail-merge-addin/taskpane.html"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GroupLabel" DefaultValue="Mail Merge"/>
        <bt:String id="TaskpaneButton.Label" DefaultValue="Run Merge"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="TaskpaneButton.Tooltip" DefaultValue="Open the Mail Merge task pane to send personalised emails to multiple recipients."/>
      </bt:LongStrings>
    </Resources>

    <WebApplicationInfo>
      <Id>a3a648da-9dc0-48ce-948a-ba2434afcadd</Id>
      <Resource>api://leighton-grey.github.io/mail-merge-addin/a3a648da-9dc0-48ce-948a-ba2434afcadd</Resource>
      <Scopes>
        <Scope>openid</Scope>
        <Scope>profile</Scope>
        <Scope>Mail.Send</Scope>
        <Scope>Contacts.Read</Scope>
        <Scope>User.Read</Scope>
        <Scope>People.Read</Scope>
      </Scopes>
    </WebApplicationInfo>

  </VersionOverrides>
</OfficeApp>
