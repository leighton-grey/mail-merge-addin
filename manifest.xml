<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Mail Merge Outlook Add-in Manifest (Production: Promethean IT) — Desktop client configuration -->
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
  xsi:type="MailApp">

  <!-- Unique GUID for this add-in — must never change once deployed, used to identify all updates -->
  <Id>6917ba68-9d86-45d7-8ca5-354503f5983a</Id>
  <!-- Version number — increment for each release to AppSource; format: major.minor.patch.build -->
  <Version>2.4.0.0</Version>
  <!-- Publisher name displayed in Office Store and add-in details -->
  <ProviderName>Promethean IT</ProviderName>
  <!-- Default language/locale for all default/invariant text values -->
  <DefaultLocale>en-US</DefaultLocale>
  <!-- Add-in name shown to users in the Office Store and ribbon/menu -->
  <DisplayName DefaultValue="Mail Merge"/>
  <!-- Short description shown in the Office Store listing -->
  <Description DefaultValue="CSV mail merge with scheduling, opt-out list, and rate limiting."/>

  <!-- IconUrl and HighResolutionIconUrl: URLs to 96x96 icon; must be HTTPS and cross-origin accessible -->
  <IconUrl DefaultValue="https://leighton-grey.github.io/mail-merge-addin/assets/icon-80.png"/>
  <HighResolutionIconUrl DefaultValue="https://leighton-grey.github.io/mail-merge-addin/assets/icon-80.png"/>
  <!-- AppDomains: Outlook only loads dialogs from these domains; Office blocks navigation outside this list -->
  <AppDomains>
    <AppDomain>https://leighton-grey.github.io</AppDomain>
  </AppDomains>

  <!-- Hosts: specifies this is a Mail add-in (compose/read mode in Outlook) -->
  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>

  <!-- Requirements: minimum API set versions needed for this add-in to function -->
  <Requirements>
    <Sets>
      <!-- Mailbox 1.5 required for certain API methods; higher MinVersion = more features but less compatibility -->
      <Set Name="Mailbox" MinVersion="1.5"/>
    </Sets>
  </Requirements>

  <!-- FormSettings + Rule: v1.1 legacy activation mechanism for older Outlook clients that don't process VersionOverrides -->
  <FormSettings>
    <Form xsi:type="ItemEdit">
      <DesktopSettings>
        <!-- SourceLocation: URL to the taskpane HTML — must be served over HTTPS; cannot be localhost -->
        <SourceLocation DefaultValue="https://leighton-grey.github.io/mail-merge-addin/taskpane.html"/>
      </DesktopSettings>
    </Form>
  </FormSettings>

  <!-- Permissions: ReadWriteMailbox grants access to modify mail item properties and send mail -->
  <Permissions>ReadWriteMailbox</Permissions>

  <!-- Rule: when add-in shows in ribbon; ItemType="Message" + FormType="Edit" = compose/reply/forward only -->
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Edit"/>
  </Rule>

  <!-- DisableEntityHighlighting: prevents smart suggestions (entity highlighting) from being applied -->
  <DisableEntityHighlighting>false</DisableEntityHighlighting>

  <!-- VersionOverrides: modern (v1.0+) ribbon UI and command configuration used by newer Outlook clients (web, new Mac, Windows) -->
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">

    <!-- Requirements in VersionOverrides override the top-level Requirements for modern clients -->
    <Requirements>
      <!-- DefaultMinVersion must match the minimum version needed for all resources and commands used below -->
      <bt:Sets DefaultMinVersion="1.5">
        <bt:Set Name="Mailbox"/>
      </bt:Sets>
    </Requirements>

    <!-- Hosts: ribbon and command surface definition for modern Outlook UI -->
    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>
          <!-- ExtensionPoint: MessageComposeCommandSurface = compose ribbon; defines button placement and behavior -->
          <ExtensionPoint xsi:type="MessageComposeCommandSurface">
            <!-- OfficeTab id="TabDefault": adds button to the default "Home" or compose ribbon tab -->
            <OfficeTab id="TabDefault">
              <!-- Group: organizes related buttons; Label and Icon shown in the ribbon -->
              <Group id="msgComposeGroup">
                <Label resid="GroupLabel"/>
                <Icon>
                  <bt:Image size="16" resid="Icon.16x16"/>
                  <bt:Image size="32" resid="Icon.32x32"/>
                  <bt:Image size="80" resid="Icon.80x80"/>
                </Icon>
                <!-- Control: the "Run Merge" button; Action ShowTaskpane loads the taskpane HTML on click -->
                <Control xsi:type="Button" id="MessageComposeActionId">
                  <Label resid="TaskpaneButton.Label"/>
                  <Supertip>
                    <Title resid="TaskpaneButton.Label"/>
                    <Description resid="TaskpaneButton.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>

    <!-- Resources: all images, URLs, and localizable strings; referenced via resid attributes above -->
    <Resources>
      <!-- bt:Images: icon files in multiple sizes for different UI contexts (ribbon, store, etc.) -->
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://leighton-grey.github.io/mail-merge-addin/assets/icon-16.png"/>
        <bt:Image id="Icon.32x32" DefaultValue="https://leighton-grey.github.io/mail-merge-addin/assets/icon-32.png"/>
        <bt:Image id="Icon.80x80" DefaultValue="https://leighton-grey.github.io/mail-merge-addin/assets/icon-80.png"/>
      </bt:Images>
      <!-- bt:Urls: taskpane and command/function file URLs loaded at runtime -->
      <bt:Urls>
        <bt:Url id="Taskpane.Url" DefaultValue="https://leighton-grey.github.io/mail-merge-addin/taskpane.html"/>
      </bt:Urls>
      <!-- bt:ShortStrings: UI labels (ribbon group, button); max ~127 chars for ribbon fit -->
      <bt:ShortStrings>
        <bt:String id="GroupLabel" DefaultValue="Mail Merge"/>
        <bt:String id="TaskpaneButton.Label" DefaultValue="Run Merge"/>
      </bt:ShortStrings>
      <!-- bt:LongStrings: tooltip and description text; shown in Office Store and on hover -->
      <bt:LongStrings>
        <bt:String id="TaskpaneButton.Tooltip" DefaultValue="Open the Mail Merge task pane to send personalised emails to multiple recipients."/>
      </bt:LongStrings>
    </Resources>

  </VersionOverrides>
</OfficeApp>
