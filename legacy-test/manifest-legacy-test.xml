<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Mail Merge Outlook Add-in Manifest (Legacy Outlook for Mac Test Build) — dual activation for old + new clients -->
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
  xsi:type="MailApp">

  <!-- Unique ID — different from manifest-personal.xml so both can be installed side-by-side without Outlook treating them as duplicates -->
  <Id>f4a9c21b-7de3-4b8f-9c1e-a35824cfd607</Id>
  <!-- Version number — aligned with personal version since this is a test build of the same release -->
  <Version>2.6.1</Version>
  <!-- Publisher name for test/experimental distribution -->
  <ProviderName>Grey8Ghost</ProviderName>
  <!-- Default language/locale for all default/invariant text values -->
  <DefaultLocale>en-US</DefaultLocale>
  <!-- Add-in name; "Legacy Test" suffix indicates this is for testing old Outlook for Mac compatibility -->
  <DisplayName DefaultValue="Mail Merge Legacy Test"/>
  <!-- Description notes this is a legacy test build and points to the shared dev taskpane -->
  <Description DefaultValue="Legacy Outlook for Mac test build of the Mail Merge add-in. Points to the same hosted taskpane as the dev version."/>

  <!-- IconUrl and HighResolutionIconUrl: must be HTTPS; hosted on grey8ghost GitHub pages -->
  <IconUrl DefaultValue="https://grey8ghost.github.io/Mail-Merge/assets/icon-80.png"/>
  <HighResolutionIconUrl DefaultValue="https://grey8ghost.github.io/Mail-Merge/assets/icon-80.png"/>

  <!-- SupportUrl: link to GitHub project or documentation -->
  <SupportUrl DefaultValue="https://grey8ghost.github.io/Mail-Merge"/>

  <!-- AppDomains: restricts dialog navigation to this domain; protocol/path not required for broader matching -->
  <AppDomains>
    <AppDomain>grey8ghost.github.io</AppDomain>
  </AppDomains>

  <!-- Hosts: specifies Mail add-in type -->
  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>

  <!-- Mailbox 1.1 is the minimum required by legacy Outlook for Mac; keeping this low maximizes compatibility with old builds -->
  <Requirements>
    <Sets>
      <!-- 1.1 supports FormSettings + Rule activation used by legacy clients that predate VersionOverrides -->
      <Set Name="Mailbox" MinVersion="1.1"/>
    </Sets>
  </Requirements>

  <!-- FormSettings + Rule: the legacy v1.1 activation mechanism; used by old Outlook for Mac and clients predating VersionOverrides -->
  <!-- Legacy Outlook for Mac reads these when it cannot process VersionOverrides; newer clients prefer VersionOverrides below -->
  <FormSettings>
    <Form xsi:type="ItemEdit">
      <DesktopSettings>
        <!-- SourceLocation: URL to taskpane HTML; used as fallback when VersionOverrides is not supported -->
        <SourceLocation DefaultValue="https://grey8ghost.github.io/Mail-Merge/taskpane.html"/>
      </DesktopSettings>
    </Form>
  </FormSettings>

  <!-- Permissions: ReadWriteItem grants minimal permission to modify only the current item (not the entire mailbox) -->
  <Permissions>ReadWriteItem</Permissions>

  <!-- Rule: when add-in shows in ribbon; matches compose/reply/forward scenarios only -->
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Edit"/>
  </Rule>

  <!-- VersionOverrides: modern ribbon UI and command definitions used by Windows Outlook, web, and new Mac clients; ignored by legacy Outlook -->
  <!-- This dual-activation pattern ensures the add-in works on both old (FormSettings/Rule) and new (VersionOverrides) clients -->
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">

    <!-- Requirements in VersionOverrides override top-level Requirements for modern clients that support VersionOverrides -->
    <Requirements>
      <!-- DefaultMinVersion 1.3 supports FunctionFile and advanced ribbon customization on modern Outlook clients -->
      <bt:Sets DefaultMinVersion="1.3">
        <bt:Set Name="Mailbox"/>
      </bt:Sets>
    </Requirements>

    <!-- Hosts: ribbon UI and command surface definitions used by modern Outlook clients -->
    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>

          <!-- FunctionFile: URL to commands.html (hidden iframe); handles ribbon button command execution and keyboard shortcuts -->
          <FunctionFile resid="Commands.Url"/>

          <!-- ExtensionPoint: MessageComposeCommandSurface = buttons appear in the compose ribbon of modern Outlook -->
          <ExtensionPoint xsi:type="MessageComposeCommandSurface">
            <!-- OfficeTab id="TabDefault": adds button to the default Home or compose tab -->
            <OfficeTab id="TabDefault">
              <!-- Group: button group with label for visual organization in the ribbon -->
              <Group id="msgComposeGroup">
                <Label resid="GroupLabel"/>
                <!-- Control: the "Run Merge" button; ShowTaskpane loads taskpane.html in a side panel on click -->
                <Control xsi:type="Button" id="btnOpenMerge">
                  <Label resid="TaskpaneButton.Label"/>
                  <Supertip>
                    <!-- Title and Description shown in tooltip on button hover -->
                    <Title resid="TaskpaneButton.SupertipTitle"/>
                    <Description resid="Btn.TipDesc"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <!-- Action ShowTaskpane: opens the taskpane HTML when button clicked -->
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>

        </DesktopFormFactor>
      </Host>
    </Hosts>

    <!-- Resources: all images, URLs, and localizable strings referenced via resid attributes in manifest above -->
    <Resources>
      <!-- bt:Images: icon PNG files in multiple sizes for ribbon, Office Store, and system UI contexts -->
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://grey8ghost.github.io/Mail-Merge/assets/icon-16.png"/>
        <bt:Image id="Icon.32x32" DefaultValue="https://grey8ghost.github.io/Mail-Merge/assets/icon-32.png"/>
        <bt:Image id="Icon.80x80" DefaultValue="https://grey8ghost.github.io/Mail-Merge/assets/icon-80.png"/>
      </bt:Images>
      <!-- bt:Urls: Commands.Url points to commands.html (hidden frame); Taskpane.Url is the visible user-facing panel -->
      <bt:Urls>
        <bt:Url id="Commands.Url" DefaultValue="https://grey8ghost.github.io/Mail-Merge/taskpane.html"/>
        <bt:Url id="Taskpane.Url" DefaultValue="https://grey8ghost.github.io/Mail-Merge/taskpane.html"/>
      </bt:Urls>
      <!-- bt:ShortStrings: ribbon UI labels; must be brief enough to fit in compact ribbon layouts -->
      <bt:ShortStrings>
        <bt:String id="GroupLabel" DefaultValue="Mail Merge"/>
        <bt:String id="TaskpaneButton.Label" DefaultValue="Run Merge"/>
        <bt:String id="TaskpaneButton.SupertipTitle" DefaultValue="Run Mail Merge"/>
      </bt:ShortStrings>
      <!-- bt:LongStrings: tooltip and help text shown on button hover and in Office Store description -->
      <bt:LongStrings>
        <bt:String id="Btn.TipDesc" DefaultValue="Open the Mail Merge task pane to send personalised emails to multiple recipients."/>
      </bt:LongStrings>
    </Resources>

  </VersionOverrides>

</OfficeApp>
