<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Mail Merge Outlook Add-in Manifest (Personal/Dev) — open-source version hosted on Grey8Ghost GitHub pages -->
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
  xsi:type="MailApp">

  <!-- Unique GUID for this add-in — different from manifest.xml so this can be installed alongside the production version -->
  <Id>b7f3d21e-4ac1-4e8b-9c7f-cd3548bfd910</Id>
  <!-- Version number — kept independent from production manifest for separate release cadence -->
  <Version>2.6.1</Version>
  <!-- Publisher name for open-source/personal distribution -->
  <ProviderName>Grey8Ghost</ProviderName>
  <!-- Default language/locale for all default/invariant text values -->
  <DefaultLocale>en-US</DefaultLocale>
  <!-- Add-in name; "Dev" suffix helps users distinguish this from the production version -->
  <DisplayName DefaultValue="Mail Merge Dev"/>
  <!-- Description emphasizes privacy-first design and open-source nature -->
  <Description DefaultValue="A free, open-source mail merge add-in for New Outlook. Processes all data locally in your browser — zero data ever touches our servers."/>

  <!-- IconUrl and HighResolutionIconUrl: must be HTTPS; hosted on grey8ghost GitHub pages -->
  <IconUrl DefaultValue="https://grey8ghost.github.io/Mail-Merge/assets/icon-80.png"/>
  <HighResolutionIconUrl DefaultValue="https://grey8ghost.github.io/Mail-Merge/assets/icon-80.png"/>

  <!-- SupportUrl: link to GitHub project page or documentation -->
  <SupportUrl DefaultValue="https://grey8ghost.github.io/Mail-Merge"/>

  <!-- AppDomains: multiple domains allowed; HTTPS protocol must be included when restricting via URL scheme -->
  <AppDomains>
    <!-- Primary domain where taskpane and functions are hosted -->
    <AppDomain>https://grey8ghost.github.io</AppDomain>
    <!-- Secondary domain for backward compatibility or fallback scenarios -->
    <AppDomain>https://leighton-grey.github.io</AppDomain>
  </AppDomains>

  <!-- Hosts: specifies Mail add-in type -->
  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>

  <!-- Requirements: minimum API set versions for legacy/fallback activation (FormSettings rule below) -->
  <Requirements>
    <Sets>
      <!-- Mailbox 1.1 baseline ensures broadest compatibility with all Outlook versions -->
      <Set Name="Mailbox" MinVersion="1.1"/>
    </Sets>
  </Requirements>

  <!-- FormSettings + Rule: v1.1 legacy activation for older clients that ignore VersionOverrides -->
  <FormSettings>
    <Form xsi:type="ItemEdit">
      <DesktopSettings>
        <!-- SourceLocation: URL to taskpane HTML; served from grey8ghost GitHub pages -->
        <SourceLocation DefaultValue="https://grey8ghost.github.io/Mail-Merge/taskpane.html"/>
      </DesktopSettings>
    </Form>
  </FormSettings>

  <!-- Permissions: ReadWriteItem grants minimal permission to modify only the current item (not the mailbox) -->
  <Permissions>ReadWriteItem</Permissions>

  <!-- Rule: when add-in shows in ribbon; matches compose/reply/forward scenarios only -->
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Edit"/>
  </Rule>

  <!-- VersionOverrides: modern ribbon UI and command definitions used by Windows Outlook, web, and new Mac clients -->
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">

    <!-- Requirements in VersionOverrides override top-level Requirements for modern clients -->
    <Requirements>
      <!-- DefaultMinVersion 1.3 supports FunctionFile and advanced ribbon customization on modern Outlook -->
      <bt:Sets DefaultMinVersion="1.3">
        <bt:Set Name="Mailbox"/>
      </bt:Sets>
    </Requirements>

    <!-- Hosts: ribbon UI and command surface definitions -->
    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>

          <!-- FunctionFile: URL to commands.html (hidden iframe); handles ribbon button command execution and events -->
          <FunctionFile resid="Commands.Url"/>

          <!-- ExtensionPoint: MessageComposeCommandSurface = buttons appear in the compose ribbon -->
          <ExtensionPoint xsi:type="MessageComposeCommandSurface">
            <!-- OfficeTab id="TabDefault": adds button to default Home tab -->
            <OfficeTab id="TabDefault">
              <!-- Group: button group with label for visual organization in the ribbon -->
              <Group id="msgComposeGroup">
                <Label resid="GroupLabel"/>
                <!-- Control: the "Run Merge" button; ShowTaskpane loads taskpane.html in a side panel on click -->
                <Control xsi:type="Button" id="btnOpenMerge">
                  <Label resid="TaskpaneButton.Label"/>
                  <Supertip>
                    <Title resid="TaskpaneButton.SupertipTitle"/>
                    <Description resid="Btn.TipDesc"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>

        </DesktopFormFactor>
      </Host>
    </Hosts>

    <!-- Resources: all images, URLs, and localizable strings referenced via resid in manifest above -->
    <Resources>
      <!-- bt:Images: icon PNG files in multiple sizes for ribbon, store, and system UI -->
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://grey8ghost.github.io/Mail-Merge/assets/icon-16.png"/>
        <bt:Image id="Icon.32x32" DefaultValue="https://grey8ghost.github.io/Mail-Merge/assets/icon-32.png"/>
        <bt:Image id="Icon.80x80" DefaultValue="https://grey8ghost.github.io/Mail-Merge/assets/icon-80.png"/>
      </bt:Images>
      <!-- bt:Urls: Commands.Url points to commands.html; Taskpane.Url is the visible side panel -->
      <bt:Urls>
        <bt:Url id="Commands.Url" DefaultValue="https://grey8ghost.github.io/Mail-Merge/taskpane.html"/>
        <bt:Url id="Taskpane.Url" DefaultValue="https://grey8ghost.github.io/Mail-Merge/taskpane.html"/>
      </bt:Urls>
      <!-- bt:ShortStrings: ribbon labels; brief enough to fit in compact ribbon layouts -->
      <bt:ShortStrings>
        <bt:String id="GroupLabel" DefaultValue="Mail Merge"/>
        <bt:String id="TaskpaneButton.Label" DefaultValue="Run Merge"/>
        <bt:String id="TaskpaneButton.SupertipTitle" DefaultValue="Run Mail Merge"/>
      </bt:ShortStrings>
      <!-- bt:LongStrings: tooltip and help text; shown on button hover and in Office Store descriptions -->
      <bt:LongStrings>
        <bt:String id="Btn.TipDesc" DefaultValue="Open the Mail Merge task pane to send personalised emails to multiple recipients."/>
      </bt:LongStrings>
    </Resources>

  </VersionOverrides>

</OfficeApp>
